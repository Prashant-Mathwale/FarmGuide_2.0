# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/farmguide

# Authentication Secret
JWT_SECRET=supersecretjwtkey_replace_in_production

# External APIs
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Microservices
ML_SERVICE_URL=http://127.0.0.1:8000

# Community & Media Storage
# Storage Driver: 'local' (saves to server/uploads/community) or 'cloudinary'
STORAGE_DRIVER=local

# Cloudinary Credentials (Required only if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Community Rate Limits & Moderation Thresholds
COMMUNITY_POSTS_PER_HOUR=20
COMMUNITY_COMMENTS_PER_HOUR=60
COMMUNITY_REPORT_HIDE_THRESHOLD=3
COMMUNITY_MAX_IMAGE_MB=5
COMMUNITY_MAX_IMAGES=3
COMMUNITY_POST_TITLE_MAX=120
COMMUNITY_POST_BODY_MAX=2000
COMMUNITY_COMMENT_BODY_MAX=1000
